# ─── FileFlowOne — Environment Variables ────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is already in .gitignore.

# ─── AI / Groq ───────────────────────────────────────────────────────────────
# Required for: AI Chat, AI Modify, AI Content Detection & Humanizer.
# Get a free key at https://console.groq.com (no credit card needed).
GROQ_API_KEY=

# ─── Supabase (optional) ─────────────────────────────────────────────────────
# Required for: cloud template sync, community gallery, user accounts.
# If left blank the app runs fully offline — cloud features are hidden.
#
# 1. Create a free project at https://supabase.com
# 2. Run supabase/schema.sql in your project's SQL Editor
# 3. Copy the Project URL and anon/public key from Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
