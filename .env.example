# ─── FileFlowOne — Environment Variables ────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is already in .gitignore.

# ─── AI Providers ────────────────────────────────────────────────────────────
# Required for: AI Chat, AI Modify, AI Content Detection & Humanizer, PDF Auto-format.
# At least one key is needed for AI features. Groq is free (no credit card).
#
# The app picks the first provider in AI_PROVIDER_PRIORITY that has a key set.
# Providers without a key are skipped. With no keys, AI features are unavailable.

# Groq — free & fast. Get a key at https://console.groq.com
GROQ_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey  (GOOGLE_GENERATIVE_AI_API_KEY also accepted)
GEMINI_API_KEY=

# OpenAI (paid) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# DeepSeek (paid) — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Provider priority — comma-separated. First one with a key wins.
AI_PROVIDER_PRIORITY=groq,gemini,openai,deepseek

# ─── Supabase (optional) ─────────────────────────────────────────────────────
# Required for: cloud template sync, community gallery, user accounts.
# If left blank the app runs fully offline — cloud features are hidden.
#
# 1. Create a free project at https://supabase.com
# 2. Run supabase/schema.sql in your project's SQL Editor
# 3. Copy the Project URL and anon/public key from Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
